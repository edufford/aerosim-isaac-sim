[package]
title = "AeroSim Isaac Sim Dev App"
description = "An AeroSim Isaac Sim application with full development extensions enabled."
version = "0.1.0"
keywords = ["AeroSim", "Isaac Sim", "dev", "app"]

[dependencies]
# Isaac Sim full experience (includes all GUI, dev tools, sensors, etc.)
"isaacsim.exp.full" = {}

# AeroSim extension (scene graph management, middleware, camera sensor capture)
"aerosim.omniverse.extension" = {}

# Cesium for Omniverse (geospatial terrain rendering)
"cesium.omniverse" = {}

[settings.app.exts]
folders.'++' = ["${app}/../exts"]

[settings]
exts."cesium.omniverse".showOnStartup = false
app.useFabricSceneDelegate = true
app.usdrt.scene_delegate.enableProxyCubes = false
app.usdrt.scene_delegate.geometryStreaming.enabled = false

[settings.app.livestream]
skipCapture = 1
webrtcEtli = true

[[test]]
enabled = false

[settings.exts."omni.kit.registry.nucleus"]
registries = [
    { name = "kit/default", url = "https://ovextensionsprod.blob.core.windows.net/exts/kit/prod/107/shared" },
    { name = "kit/sdk", url = "https://ovextensionsprod.blob.core.windows.net/exts/kit/prod/sdk/${kit_version_short}/${kit_git_hash}" },
    { name = "kit/community", url = "https://dw290v42wisod.cloudfront.net/exts/kit/community" },
]
